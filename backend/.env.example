DATABASE_URL=sqlite:///./community.db
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Quản trị viên mặc định
ADMIN_EMAIL=admin@kindred.local
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here

# Danh sách nguồn CORS cho phép (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,https://caithunhat.vercel.app

# Stringee Call API (keep all secrets on the backend; never use VITE_ prefixes)
STRINGEE_API_KEY_SID=your_stringee_api_key_sid
STRINGEE_API_KEY_SECRET=your_stringee_api_key_secret
STRINGEE_SIGNING_SECRET=your_stringee_project_signing_secret
STRINGEE_ACCESS_TOKEN_TTL_SECONDS=3600
